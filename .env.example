# Any OpenAI-compatible provider. OpenRouter (free tier, no card):
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openrouter/free
# Ollama instead: LLM_BASE_URL=http://localhost:11434/v1/  LLM_API_KEY=ollama  LLM_MODEL=gemma3:1b

# LLM_STUB=1 answers YES/NO with a keyword rule instead of calling a model (no key needed)
LLM_STUB=

# Local development: talk to the Inngest dev server instead of Inngest Cloud
INNGEST_DEV=1
